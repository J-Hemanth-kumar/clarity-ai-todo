# Optional. Without this key, all manual task features continue to work.
GEMINI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional PostgreSQL URL. Set this for a durable hosted database.
# When blank, local development uses SQLite in ./data.
DATABASE_URL=

# The app creates this directory automatically for local SQLite.
DATA_DIR=./data

# Development API port. Replit sets PORT automatically in production.
API_PORT=3001
